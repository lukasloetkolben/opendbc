CM_ "CAN FD frames are AUTOSAR containers of 12-byte PDUs. Protected PDUs carry a CRC8 J1850 in PDU byte 0 and a 0-14 counter in PDU byte 1; CHECKSUM and ROLLING_COUNTER are those of the PDU with the signals. The counter is not named COUNTER because the senders repeat and skip values.";
CM_ SG_ 137 LKACmd "neutral raw 0x7F58";
CM_ SG_ 137 LKAReqToqA "EPS torque limit to the left";
CM_ SG_ 137 LKAReqToqB "EPS torque limit to the right";
CM_ SG_ 192 DriverTorque "raw counts, left positive";
CM_ SG_ 319 WhlSpdFR "coarser than the other wheels";
CM_ SG_ 319 YawRate "left positive";
CM_ BO_ 366 "the PDU at byte 24 has no CRC. GAS_PEDAL and ESP_ACCEL echo the executed regime, so the radar cancels its ACC if openpilot overrides it while engaged.";
CM_ SG_ 366 AccAccelReq "followed in the decel regime";
CM_ SG_ 366 AccTorqueReq "followed in the torque regime, 160 = no drive torque";
CM_ SG_ 366 AccSetSpeedHalf "set speed = AccSetSpeedHalf + AccSetSpeedOdd";
CM_ BO_ 474 "Raw00..Raw11 carry the whole frame so it can be forwarded";
CM_ SG_ 474 HandsOnWarnLvl "1 = OK";
VAL_ 137 LKACmdSts 0 "OFF" 4 "ACTIVE";
VAL_ 404 ShftLvrPos 1 "P" 2 "R" 3 "N" 4 "D";
VAL_ 474 AccSts 0 "OFF" 1 "ACC_ENGAGED" 2 "ACC_AND_TJA";
VAL_ 366 AccCmdMode 2 "PASSIVE" 4 "REGULATING" 5 "RESUME" 6 "GAS_OVERRIDE" 8 "BRAKING" 10 "HOLD" 14 "CANCEL";
VAL_ 1019 DircnIndSwSts 0 "OFF" 1 "TAP" 2 "LATCHED";
